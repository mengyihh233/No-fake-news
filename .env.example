# Environment variables are optional. The web UI can supply settings per request.
# python app.py loads project .env; existing process variables take precedence.
# 可在网页填写，或复制本文件为 .env；请勿提交真实密钥。
# 画面で設定、または .env にコピー。実際のキーをコミットしないでください。
TRUTH_AI_BASE_URL=https://api.openai.com/v1
TRUTH_AI_API_KEY=
TRUTH_AI_MODEL=
# DeepSeek: https://api.deepseek.com + deepseek-flash, search provider deepseek.
# DeepSeek 搜索复用官方 AI 密钥 / DeepSeek 検索は公式 AI キーを再利用します。
TRUTH_SEARCH_PROVIDER=tavily
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
TRUTH_PORT=8000
